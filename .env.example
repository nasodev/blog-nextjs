# Blog frontend environment variables.
# Copy to .env.local for local development (`.env.local` is gitignored).
#
# NEXT_PUBLIC_* variables are inlined into the JS bundle at BUILD time by
# Next.js (both client and server code). Changing one in a running
# container's env does nothing until the image is rebuilt.

# backend-api base URL. Local dev API runs on port 28000; production is the
# public api.funq.kr domain (also used at Docker build time by
# generateStaticParams — see Dockerfile / .github/workflows/deploy.yml).
NEXT_PUBLIC_API_URL=http://localhost:28000

# Shared secret for POST /api/revalidate (this app's on-demand ISR route).
# REVALIDATE_SECRET (no prefix) is read at request time on the server and is
# the one that actually matters at runtime — set it in the server's runtime
# env, not as a build arg. NEXT_PUBLIC_REVALIDATE_SECRET is inlined into the
# admin UI's client bundle so it can send the "x-revalidate-secret" header;
# use the SAME value for both.
REVALIDATE_SECRET=dev-secret
NEXT_PUBLIC_REVALIDATE_SECRET=dev-secret

# Firebase Web SDK config, used for Google sign-in on /admin (funq-auth
# project). Get these from Firebase Console > Project settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
